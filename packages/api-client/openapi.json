  "info": {
    "title": "My Kanban API",
    "description": "Private API for the personal Kanban and Scrum board",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProjectSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": ["kanban", "scrum"]
          },
          "version": {
            "type": "number"
          }
        },
        "required": ["id", "name", "color", "mode", "version"]
      },
      "ProjectListResponseDto": {
        "type": "object",
        "properties": {
          "activeProjectId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummaryDto"
            }
          }
        },
        "required": ["activeProjectId", "projects"]
      },
      "UpdateProjectModeDto": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["kanban", "scrum"]
          },
          "version": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": ["mode", "version"]
      },
      "CreateIssueDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "columnId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 50000,
            "default": ""
          },
          "type": {
            "type": "string",
            "enum": ["task", "story", "bug", "chore"],
            "default": "task"
          },
          "priority": {
            "type": "string",
            "enum": ["urgent", "high", "medium", "low", "none"],
            "default": "medium"
          },
          "labels": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "storyPoints": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "nullable": true
          },
          "dueDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isBlocked": {
            "type": "boolean",
            "default": false
          },
          "blockedReason": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "beforeIssueId": {
            "type": "string",
            "format": "uuid"
          },
          "afterIssueId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["title", "columnId"]
      },
      "IssueResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "sprintId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
