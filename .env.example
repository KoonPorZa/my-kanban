# Local PostgreSQL
POSTGRES_DB=my_kanban
POSTGRES_USER=my_kanban
POSTGRES_PASSWORD=my_kanban_local
DATABASE_URL=postgresql://my_kanban:my_kanban_local@localhost:5432/my_kanban?schema=public

# Web
APP_ORIGIN=http://localhost:8083
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_AUTH_SKIP=true

# Google OIDC (required when authentication is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8083/api/v1/auth/google/callback
ALLOWED_GOOGLE_EMAILS=
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800
