generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectMode {
  kanban
  scrum
}

enum IssuePriority {
  urgent
  high
  medium
  low
  none
}

enum BoardColumnCategory {
  todo
  in_progress
  done
}

enum IssueType {
  task
  story
  bug
  chore
}

enum SprintStatus {
  planned
  active
  completed
}

enum McpClientType {
  codex
  claude
  other
}

enum IdempotencyActorType {
  user
  mcp_token
}

enum McpAuditOutcome {
  success
  rejected
  failed
}

model User {
  id          String           @id @default(uuid()) @db.Uuid
  displayName String           @map("display_name") @db.VarChar(120)
  avatarUrl   String?          @map("avatar_url")
  identities  AuthIdentity[]
  workspaces  Workspace[]
  mcpTokens   McpAccessToken[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model AuthIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(32)
  providerSubject String    @map("provider_subject") @db.VarChar(255)
  email           String    @unique @db.VarChar(320)
  emailVerified   Boolean   @map("email_verified")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model HttpSession {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("http_sessions")
}

model Workspace {
  id              String    @id @default(uuid()) @db.Uuid
  ownerId         String    @map("owner_id") @db.Uuid
  name            String    @db.VarChar(120)
  activeProjectId String?   @map("active_project_id") @db.Uuid
  version         Int       @default(1)
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  projects        Project[]
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@map("workspaces")
}

model Project {
  id                String                @id @default(uuid()) @db.Uuid
  workspaceId       String                @map("workspace_id") @db.Uuid
  name              String                @db.VarChar(120)
  color             String                @default("primary") @db.VarChar(32)
  mode              ProjectMode           @default(kanban)
  doneRetentionDays Int                   @default(30) @map("done_retention_days")
  version           Int                   @default(1)
  archivedAt        DateTime?             @map("archived_at") @db.Timestamptz(6)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns           BoardColumn[]
  issues            Issue[]
  sprints           Sprint[]
  mcpTokens         McpAccessToken[]
  idempotency       MutationIdempotency[]
  auditEvents       McpAuditEvent[]
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, archivedAt])
  @@map("projects")
}

model BoardColumn {
  id         String              @id @default(uuid()) @db.Uuid
  projectId  String              @map("project_id") @db.Uuid
  name       String              @db.VarChar(80)
  category   BoardColumnCategory @default(todo)
  rank       BigInt
  wipLimit   Int?                @map("wip_limit")
  version    Int                 @default(1)
  archivedAt DateTime?           @map("archived_at") @db.Timestamptz(6)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues     Issue[]
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, rank])
  @@index([projectId, archivedAt, rank])
  @@map("board_columns")
}

model Issue {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  sprintId      String?         @map("sprint_id") @db.Uuid
  columnId      String          @map("column_id") @db.Uuid
  title         String          @db.VarChar(200)
  description   String          @default("")
  type          IssueType       @default(task)
  priority      IssuePriority   @default(medium)
  labels        String[]
  storyPoints   Int?            @map("story_points")
  rank          BigInt
  version       Int             @default(1)
  dueDate       DateTime?       @map("due_date") @db.Timestamptz(6)
  isBlocked     Boolean         @default(false) @map("is_blocked")
  blockedReason String?         @map("blocked_reason")
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(6)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(6)
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint        Sprint?         @relation(fields: [sprintId, projectId], references: [id, projectId], onDelete: Restrict)
  column        BoardColumn     @relation(fields: [columnId], references: [id], onDelete: Restrict)
  checklist     ChecklistItem[]
  auditEvents   McpAuditEvent[]
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([columnId, rank])
  @@index([projectId, archivedAt, columnId, rank])
  @@index([projectId, sprintId, archivedAt, columnId, rank])
  @@index([projectId, dueDate])
  @@map("issues")
}

model ChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  issueId     String   @map("issue_id") @db.Uuid
  title       String   @db.VarChar(300)
  isCompleted Boolean  @default(false) @map("is_completed")
  rank        BigInt
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([issueId, rank])
  @@index([issueId, rank])
  @@map("checklist_items")
}

model Sprint {
  id                   String       @id @default(uuid()) @db.Uuid
  projectId            String       @map("project_id") @db.Uuid
  name                 String       @db.VarChar(120)
  goal                 String       @default("") @db.VarChar(500)
  status               SprintStatus @default(planned)
  startDate            DateTime     @map("start_date") @db.Date
  endDate              DateTime     @map("end_date") @db.Date
  plannedPoints        Int          @default(0) @map("planned_points")
  plannedIssueCount    Int          @default(0) @map("planned_issue_count")
  completedPoints      Int          @default(0) @map("completed_points")
  completedIssueCount  Int          @default(0) @map("completed_issue_count")
  incompletePoints     Int          @default(0) @map("incomplete_points")
  incompleteIssueCount Int          @default(0) @map("incomplete_issue_count")
  completedAt          DateTime?    @map("completed_at") @db.Timestamptz(6)
  version              Int          @default(1)
  project              Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues               Issue[]
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, projectId], map: "sprints_id_project_id_key")
  @@index([projectId, status, startDate(sort: Desc)])
  @@map("sprints")
}

model McpAccessToken {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  createdById String          @map("created_by_id") @db.Uuid
  label       String          @db.VarChar(80)
  clientType  McpClientType   @map("client_type")
  tokenPrefix String          @unique @map("token_prefix") @db.VarChar(24)
  tokenHash   String          @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(6)
  lastUsedAt  DateTime?       @map("last_used_at") @db.Timestamptz(6)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(6)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  auditEvents McpAuditEvent[]
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, revokedAt, expiresAt])
  @@index([createdById])
  @@map("mcp_access_tokens")
}

model MutationIdempotency {
  id                 String               @id @default(uuid()) @db.Uuid
  projectId          String               @map("project_id") @db.Uuid
  actorType          IdempotencyActorType @map("actor_type")
  actorId            String               @map("actor_id") @db.Uuid
  operation          String               @db.VarChar(80)
  idempotencyKey     String               @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String               @map("request_fingerprint") @db.VarChar(128)
  responseStatus     Int                  @map("response_status")
  responseBody       Json                 @map("response_body")
  expiresAt          DateTime             @map("expires_at") @db.Timestamptz(6)
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, actorType, actorId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("mutation_idempotency")
}

model McpAuditEvent {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  tokenId        String          @map("token_id") @db.Uuid
  issueId        String?         @map("issue_id") @db.Uuid
  toolName       String          @map("tool_name") @db.VarChar(80)
  requestId      String          @map("request_id") @db.VarChar(128)
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(128)
  outcome        McpAuditOutcome
  changedFields  String[]        @default([]) @map("changed_fields")
  errorCode      String?         @map("error_code") @db.VarChar(80)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  token          McpAccessToken  @relation(fields: [tokenId], references: [id], onDelete: Restrict)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([tokenId, createdAt])
  @@index([issueId])
  @@map("mcp_audit_events")
}
